```gitignore
# Dependencies
node_modules/

# Build artifacts
dist/
build/
target/

# Logs and temp files
*.log
*.tmp

# Editors
.vscode/
.idea/

# Environment
.env
.env.local
*.env.*

# Python
__pycache__/
*.pyc
*.pyo
*.pyd

# Compiled files
*.o
*.obj
*.so
*.dll
*.exe

# Compressed files
*.zip
*.gz
*.tar
*.tgz
*.bz2
*.xz
*.7z
*.rar

# System files
.DS_Store
Thumbs.db

# Coverage
coverage/
htmlcov/
.coverage

# Caching
.mypy_cache/
.pytest_cache/
.gradle/
```